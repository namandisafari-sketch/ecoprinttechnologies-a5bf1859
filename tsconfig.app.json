{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    "types": [
      "vitest/globals"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/pages/admin",
    "src/pages/seller",
    "src/components/admin",
    "src/components/seller",
    "src/components/auth",
    "src/components/cart",
    "src/components/chat",
    "src/components/checkout",
    "src/components/device",
    "src/components/home",
    "src/components/layout",
    "src/components/pos",
    "src/components/product",
    "src/components/KabejjaAdCard.tsx",
    "src/components/MaintenancePage.tsx",
    "src/components/MultiImageUpload.tsx",
    "src/components/ImageUpload.tsx",
    "src/components/NavLink.tsx",
    "src/components/ScrollToTop.tsx",
    "src/components/WelcomeToast.tsx",
    "src/contexts/AuthContext.tsx",
    "src/contexts/DeviceContext.tsx",
    "src/hooks/useAppNotifications.ts",
    "src/hooks/useChatPresence.ts",
    "src/hooks/useDevice.ts",
    "src/hooks/useMaintenanceMode.ts",
    "src/hooks/useNotificationPermission.ts",
    "src/hooks/useNotificationSound.ts",
    "src/hooks/useNotifications.ts",
    "src/hooks/useProduct.ts",
    "src/hooks/useProducts.ts",
    "src/hooks/useStoreLocation.ts",
    "src/hooks/useWishlist.ts",
    "src/lib/printPickupSlip.ts",
    "src/lib/watermark.ts",
    "src/pages/Checkout.tsx",
    "src/pages/Delivery.tsx",
    "src/pages/Login.tsx",
    "src/pages/Notifications.tsx",
    "src/pages/ProductDetail.tsx",
    "src/pages/Profile.tsx",
    "src/pages/Search.tsx",
    "src/pages/SellerSignup.tsx",
    "src/pages/Signup.tsx",
    "src/pages/Technicians.tsx",
    "src/pages/TrackOrder.tsx",
    "src/pages/Wishlist.tsx"
  ]
}