import { useMemo, useState } from "react";
import { useQuery } from "@tanstack/react-query";
import { supabase } from "@/integrations/supabase/client";
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Button } from "@/components/ui/button";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover";
import { Calendar } from "@/components/ui/calendar";
import { TrendingUp, DollarSign, Calendar as CalendarIcon, Package } from "lucide-react";
import { format, startOfDay, endOfDay, startOfMonth, endOfMonth, subMonths, startOfYear, endOfYear, startOfQuarter } from "date-fns";

type Period = "current" | "last" | "quarter" | "year" | "custom";

type MonthlyTrend = {
  month: string;
  revenue: number;
  cogs: number;
  grossProfit: number;
  expenses: number;
  netProfit: number;
};

type ReportState = {
  revenue: number;
  cogs: number;
  grossProfit: number;
  expenses: number;
  netProfit: number;
  expenseByCategory: Array<{ name: string; amount: number }>;
  assets: { cash: number; inventory: number; receivables: number };
  liabilities: { payables: number };
  monthlyTrend: MonthlyTrend[];
};

const REPORT_PAGE_SIZE = 1000;

const formatCurrency = (value: number) =>
  new Intl.NumberFormat("en-UG", {
    style: "currency",
    currency: "UGX",
    maximumFractionDigits: 0,
  }).format(Math.round(value));

const getMonthKey = (date: Date) => format(date, "MMM yyyy");

async function fetchAllPages<T>(fetchPage: (from: number, to: number) => Promise<{ data: T[] | null; error: any }>) {
  const rows: T[] = [];
  let from = 0;

  while (true) {
    const to = from + REPORT_PAGE_SIZE - 1;
    const { data, error } = await fetchPage(from, to);
    if (error) throw error;
    if (!data || data.length === 0) break;
    rows.push(...data);
    if (data.length < REPORT_PAGE_SIZE) break;
    from += REPORT_PAGE_SIZE;
  }

  return rows;
}

const Reports = () => {
  const [period, setPeriod] = useState<Period>("current");
  const [customStartDate, setCustomStartDate] = useState<Date>(startOfMonth(new Date()));
  const [customEndDate, setCustomEndDate] = useState<Date>(endOfMonth(new Date()));

  const getDateRange = () => {
    const now = new Date();
    switch (period) {
      case "current":
        return { startDate: startOfMonth(now), endDate: endOfMonth(now) };
      case "last":
        return { startDate: startOfMonth(subMonths(now, 1)), endDate: endOfMonth(subMonths(now, 1)) };
      case "quarter":
        return { startDate: startOfMonth(subMonths(now, 2)), endDate: endOfMonth(now) };
      case "year":
        return { startDate: startOfYear(now), endDate: endOfYear(now) };
      case "custom":
        return {
          startDate: customStartDate,
          endDate: customEndDate < customStartDate ? customStartDate : customEndDate,
        };
      default:
        return { startDate: startOfMonth(now), endDate: endOfMonth(now) };
    }
  };

  const { startDate, endDate } = getDateRange();
  const formattedStart = format(startDate, "yyyy-MM-dd");
  const formattedEnd = format(endDate, "yyyy-MM-dd");
  const periodLabel = `${format(startDate, "MMM dd, yyyy")} — ${format(endDate, "MMM dd, yyyy")}`;

  const { data, isLoading } = useQuery<ReportState>({
    queryKey: ["admin-reports", period, formattedStart, formattedEnd],
    queryFn: async () => {
      const rangeStart = `${format(startOfDay(startDate), "yyyy-MM-dd'T'HH:mm:ss")}`;
      const rangeEnd = `${format(endOfDay(endDate), "yyyy-MM-dd'T'HH:mm:ss")}`;
      const trendStartDate = startOfMonth(subMonths(new Date(), 5));
      const trendEndDate = endOfMonth(new Date());
      const trendStart = format(startOfDay(trendStartDate), "yyyy-MM-dd'T'HH:mm:ss");
      const trendEnd = format(endOfDay(trendEndDate), "yyyy-MM-dd'T'HH:mm:ss");

      const orders = await fetchAllPages<any>((from, to) =>
        supabase
          .from("orders")
          .select("id, total, created_at, payment_status, status, order_items(quantity, cost_price, subtotal)")
          .gte("created_at", rangeStart)
          .lte("created_at", rangeEnd)
          .order("created_at", { ascending: true })
          .range(from, to),
      );

      const expenses = await fetchAllPages<any>((from, to) =>
        supabase
          .from("expenses")
          .select("amount, expense_date, expense_categories(name)")
          .gte("expense_date", formattedStart)
          .lte("expense_date", formattedEnd)
          .order("expense_date", { ascending: true })
          .range(from, to),
      );

      const productResponse = await supabase.from("products").select("unit_cost, stock_quantity");

      const allTrendOrders = await fetchAllPages<any>((from, to) =>
        supabase
          .from("orders")
          .select("id, total, created_at, order_items(quantity, cost_price)")
          .gte("created_at", trendStart)
          .lte("created_at", trendEnd)
          .order("created_at", { ascending: true })
          .range(from, to),
      );

      const allTrendExpenses = await fetchAllPages<any>((from, to) =>
        supabase
          .from("expenses")
          .select("amount, expense_date")
          .gte("expense_date", format(trendStartDate, "yyyy-MM-dd"))
          .lte("expense_date", format(trendEndDate, "yyyy-MM-dd"))
          .order("expense_date", { ascending: true })
          .range(from, to),
      );

      const revenue = orders.reduce((sum: number, order: any) => sum + Number(order.total || 0), 0);
      const cogs = orders.reduce((sum: number, order: any) => {
        return sum + (order.order_items || []).reduce((inner: number, item: any) => inner + Number(item.cost_price || 0) * Number(item.quantity || 0), 0);
      }, 0);
      const expenseTotal = expenses.reduce((sum: number, expense: any) => sum + Number(expense.amount || 0), 0);
      const grossProfit = revenue - cogs;
      const netProfit = grossProfit - expenseTotal;

      const expenseByCategory: Record<string, number> = {};
      expenses.forEach((expense: any) => {
        const name = expense.expense_categories?.name || "Uncategorized";
        expenseByCategory[name] = (expenseByCategory[name] || 0) + Number(expense.amount || 0);
      });

      const receivables = orders
        .filter((order: any) => order.payment_status !== "paid")
        .reduce((sum: number, order: any) => sum + Number(order.total || 0), 0);

      const inventoryValue = (productResponse.data || []).reduce((sum: number, product: any) => {
        return sum + Number(product.unit_cost || 0) * Number(product.stock_quantity || 0);
      }, 0);

      const months: MonthlyTrend[] = Array.from({ length: 6 }, (_, idx) => {
        const monthDate = startOfMonth(subMonths(new Date(), 5 - idx));
        return {
          month: format(monthDate, "MMM yyyy"),
          revenue: 0,
          cogs: 0,
          grossProfit: 0,
          expenses: 0,
          netProfit: 0,
        };
      });

      const monthIndexMap = new Map(months.map((item, index) => [item.month, index]));

      allTrendOrders.forEach((order: any) => {
        const month = getMonthKey(new Date(order.created_at));
        const index = monthIndexMap.get(month);
        if (index !== undefined) {
          const orderRevenue = Number(order.total || 0);
          const orderCogs = (order.order_items || []).reduce((inner: number, item: any) => inner + Number(item.cost_price || 0) * Number(item.quantity || 0), 0);
          months[index].revenue += orderRevenue;
          months[index].cogs += orderCogs;
        }
      });

      allTrendExpenses.forEach((expense: any) => {
        const month = getMonthKey(new Date(expense.expense_date));
        const index = monthIndexMap.get(month);
        if (index !== undefined) {
          months[index].expenses += Number(expense.amount || 0);
        }
      });

      months.forEach((month) => {
        month.grossProfit = month.revenue - month.cogs;
        month.netProfit = month.grossProfit - month.expenses;
      });

      return {
        revenue,
        cogs,
        grossProfit,
        expenses: expenseTotal,
        netProfit,
        expenseByCategory: Object.entries(expenseByCategory).map(([name, amount]) => ({ name, amount })).sort((a, b) => b.amount - a.amount),
        assets: {
          cash: revenue,
          inventory: inventoryValue,
          receivables,
        },
        liabilities: {
          payables: 0,
        },
        monthlyTrend: months,
      };
    },
    keepPreviousData: true,
  });

  const report = data ?? {
    revenue: 0,
    cogs: 0,
    grossProfit: 0,
    expenses: 0,
    netProfit: 0,
    expenseByCategory: [],
    assets: { cash: 0, inventory: 0, receivables: 0 },
    liabilities: { payables: 0 },
    monthlyTrend: [],
  };

  const totalAssets = report.assets.cash + report.assets.inventory + report.assets.receivables;
  const totalLiabilities = report.liabilities.payables;
  const equity = totalAssets - totalLiabilities;

  const monthlyTotals = useMemo(
    () =>
      report.monthlyTrend.reduce(
        (totals, item) => ({
          revenue: totals.revenue + item.revenue,
          cogs: totals.cogs + item.cogs,
          grossProfit: totals.grossProfit + item.grossProfit,
          expenses: totals.expenses + item.expenses,
          netProfit: totals.netProfit + item.netProfit,
        }),
        { revenue: 0, cogs: 0, grossProfit: 0, expenses: 0, netProfit: 0 },
      ),
    [report.monthlyTrend],
  );

  if (isLoading) {
    return (
      <div className="flex items-center justify-center min-h-[240px]">
        <p className="text-sm text-muted-foreground">Loading financial reports…</p>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      <div className="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <h1 className="text-2xl font-bold text-foreground">Reports</h1>
          <p className="text-sm text-muted-foreground">Financial reports and business analytics</p>
        </div>
        <div className="grid grid-cols-1 gap-3 sm:grid-cols-[minmax(200px,1fr)_auto] xl:grid-cols-[minmax(200px,1fr)_minmax(200px,1fr)_auto] items-center">
          <Select value={period} onValueChange={(value) => setPeriod(value as Period)}>
            <SelectTrigger className="w-full sm:w-52"><SelectValue /></SelectTrigger>
            <SelectContent>
              <SelectItem value="current">This Month</SelectItem>
              <SelectItem value="last">Last Month</SelectItem>
              <SelectItem value="quarter">Last 3 Months</SelectItem>
              <SelectItem value="year">This Year</SelectItem>
              <SelectItem value="custom">Custom Range</SelectItem>
            </SelectContent>
          </Select>
          {period === "custom" && (
            <div className="grid grid-cols-2 gap-3">
              <Popover>
                <PopoverTrigger asChild>
                  <Button variant="outline" className="justify-between w-full">
                    <CalendarIcon className="mr-2 h-4 w-4" />{format(customStartDate, "PPP")}
                  </Button>
                </PopoverTrigger>
                <PopoverContent align="end" className="w-auto p-0">
                  <Calendar mode="single" selected={customStartDate} onSelect={(date) => date && setCustomStartDate(date)} className="p-3" />
                </PopoverContent>
              </Popover>
              <Popover>
                <PopoverTrigger asChild>
                  <Button variant="outline" className="justify-between w-full">
                    <CalendarIcon className="mr-2 h-4 w-4" />{format(customEndDate, "PPP")}
                  </Button>
                </PopoverTrigger>
                <PopoverContent align="end" className="w-auto p-0">
                  <Calendar mode="single" selected={customEndDate} onSelect={(date) => date && setCustomEndDate(date)} className="p-3" />
                </PopoverContent>
              </Popover>
            </div>
          )}
        </div>
      </div>

      <p className="text-xs text-muted-foreground">Period: {periodLabel}</p>

      <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
        <Card className="overflow-hidden">
          <CardContent className="pt-6">
            <div className="flex items-center gap-3">
              <div className="p-2 bg-green-100 rounded-lg"><TrendingUp className="h-5 w-5 text-green-600" /></div>
              <div>
                <p className="text-xs text-muted-foreground">Revenue</p>
                <p className="text-xl font-bold text-foreground">{formatCurrency(report.revenue)}</p>
              </div>
            </div>
          </CardContent>
        </Card>
        <Card className="overflow-hidden">
          <CardContent className="pt-6">
            <div className="flex items-center gap-3">
              <div className="p-2 bg-blue-100 rounded-lg"><Package className="h-5 w-5 text-blue-600" /></div>
              <div>
                <p className="text-xs text-muted-foreground">COGS</p>
                <p className="text-xl font-bold text-blue-600">{formatCurrency(report.cogs)}</p>
              </div>
            </div>
          </CardContent>
        </Card>
        <Card className="overflow-hidden">
          <CardContent className="pt-6">
            <div className="flex items-center gap-3">
              <div className={`p-2 rounded-lg ${report.grossProfit >= 0 ? "bg-emerald-100" : "bg-red-100"}`}><TrendingUp className={`h-5 w-5 ${report.grossProfit >= 0 ? "text-emerald-600" : "text-red-600"}`} /></div>
              <div>
                <p className="text-xs text-muted-foreground">Gross Profit</p>
                <p className={`text-xl font-bold ${report.grossProfit >= 0 ? "text-emerald-600" : "text-red-600"}`}>{formatCurrency(report.grossProfit)}</p>
              </div>
            </div>
          </CardContent>
        </Card>
        <Card className={`overflow-hidden ${report.netProfit >= 0 ? "border-green-500" : "border-red-500"}`}>
          <CardContent className="pt-6">
            <div className="flex items-center gap-3">
              <div className={`p-2 rounded-lg ${report.netProfit >= 0 ? "bg-green-100" : "bg-red-100"}`}><DollarSign className={`h-5 w-5 ${report.netProfit >= 0 ? "text-green-600" : "text-red-600"}`} /></div>
              <div>
                <p className="text-xs text-muted-foreground">Net Profit</p>
                <p className={`text-xl font-bold ${report.netProfit >= 0 ? "text-green-600" : "text-red-600"}`}>{formatCurrency(report.netProfit)}</p>
              </div>
            </div>
          </CardContent>
        </Card>
      </div>

      <Tabs defaultValue="income" className="space-y-4">
        <TabsList>
          <TabsTrigger value="income">Income Statement</TabsTrigger>
          <TabsTrigger value="balance">Balance Sheet</TabsTrigger>
          <TabsTrigger value="trends">Trends</TabsTrigger>
        </TabsList>

        <TabsContent value="income">
          <Card>
            <CardHeader>
              <CardTitle>Income Statement</CardTitle>
              <CardDescription>Profit and loss for the selected period</CardDescription>
            </CardHeader>
            <CardContent>
              <Table>
                <TableHeader>
                  <TableRow>
                    <TableHead>Item</TableHead>
                    <TableHead className="text-right">Amount</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  <TableRow className="font-medium bg-muted/50"><TableCell colSpan={2}>Revenue</TableCell></TableRow>
                  <TableRow><TableCell className="pl-8">Sales Revenue</TableCell><TableCell className="text-right">{formatCurrency(report.revenue)}</TableCell></TableRow>
                  <TableRow><TableCell className="pl-8">Cost of Goods Sold</TableCell><TableCell className="text-right text-destructive">-{formatCurrency(report.cogs)}</TableCell></TableRow>
                  <TableRow className="font-bold border-t bg-emerald-50"><TableCell>Gross Profit</TableCell><TableCell className={`text-right ${report.grossProfit >= 0 ? "text-emerald-600" : "text-red-600"}`}>{formatCurrency(report.grossProfit)}</TableCell></TableRow>
                  <TableRow className="font-medium bg-muted/50"><TableCell colSpan={2}>Operating Expenses</TableCell></TableRow>
                  {report.expenseByCategory.map((item) => (
                    <TableRow key={item.name}><TableCell className="pl-8 capitalize">{item.name}</TableCell><TableCell className="text-right text-destructive">-{formatCurrency(item.amount)}</TableCell></TableRow>
                  ))}
                  <TableRow className="font-bold border-t"><TableCell>Total Expenses</TableCell><TableCell className="text-right text-destructive">-{formatCurrency(report.expenses)}</TableCell></TableRow>
                  <TableRow className="font-bold border-t-2 bg-muted"><TableCell>Net Profit</TableCell><TableCell className={`text-right ${report.netProfit >= 0 ? "text-emerald-600" : "text-red-600"}`}>{formatCurrency(report.netProfit)}</TableCell></TableRow>
                </TableBody>
              </Table>
            </CardContent>
          </Card>
        </TabsContent>

        <TabsContent value="balance">
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <Card>
              <CardHeader>
                <CardTitle>Assets</CardTitle>
              </CardHeader>
              <CardContent>
                <Table>
                  <TableBody>
                    <TableRow className="font-medium bg-muted/50"><TableCell>Current Assets</TableCell><TableCell /></TableRow>
                    <TableRow><TableCell className="pl-8">Cash from Sales</TableCell><TableCell className="text-right">{formatCurrency(report.assets.cash)}</TableCell></TableRow>
                    <TableRow><TableCell className="pl-8">Inventory Value</TableCell><TableCell className="text-right">{formatCurrency(report.assets.inventory)}</TableCell></TableRow>
                    <TableRow><TableCell className="pl-8">Accounts Receivable</TableCell><TableCell className="text-right">{formatCurrency(report.assets.receivables)}</TableCell></TableRow>
                    <TableRow className="font-bold border-t-2 bg-muted"><TableCell>Total Assets</TableCell><TableCell className="text-right">{formatCurrency(totalAssets)}</TableCell></TableRow>
                  </TableBody>
                </Table>
              </CardContent>
            </Card>
            <Card>
              <CardHeader>
                <CardTitle>Liabilities & Equity</CardTitle>
              </CardHeader>
              <CardContent>
                <Table>
                  <TableBody>
                    <TableRow className="font-medium bg-muted/50"><TableCell>Current Liabilities</TableCell><TableCell /></TableRow>
                    <TableRow><TableCell className="pl-8">Accounts Payable</TableCell><TableCell className="text-right">{formatCurrency(report.liabilities.payables)}</TableCell></TableRow>
                    <TableRow className="font-bold border-t-2 bg-muted"><TableCell>Total Liabilities</TableCell><TableCell className="text-right">{formatCurrency(totalLiabilities)}</TableCell></TableRow>
                    <TableRow className="font-medium bg-muted/50 mt-4"><TableCell>Owner's Equity</TableCell><TableCell /></TableRow>
                    <TableRow><TableCell className="pl-8">Retained Earnings</TableCell><TableCell className="text-right">{formatCurrency(equity)}</TableCell></TableRow>
                    <TableRow className="font-bold border-t-2 bg-muted"><TableCell>Total Liabilities & Equity</TableCell><TableCell className="text-right">{formatCurrency(totalAssets)}</TableCell></TableRow>
                  </TableBody>
                </Table>
              </CardContent>
            </Card>
          </div>
        </TabsContent>

        <TabsContent value="trends">
          <Card>
            <CardHeader>
              <CardTitle>Monthly Performance (Last 6 Months)</CardTitle>
            </CardHeader>
            <CardContent>
              <Table>
                <TableHeader>
                  <TableRow>
                    <TableHead>Month</TableHead>
                    <TableHead className="text-right">Revenue</TableHead>
                    <TableHead className="text-right">COGS</TableHead>
                    <TableHead className="text-right">Gross Profit</TableHead>
                    <TableHead className="text-right">Expenses</TableHead>
                    <TableHead className="text-right">Net Profit</TableHead>
                    <TableHead className="text-right">Margin</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {report.monthlyTrend.map((item) => (
                    <TableRow key={item.month}>
                      <TableCell className="font-medium">{item.month}</TableCell>
                      <TableCell className="text-right">{formatCurrency(item.revenue)}</TableCell>
                      <TableCell className="text-right text-blue-600">{formatCurrency(item.cogs)}</TableCell>
                      <TableCell className={`text-right ${item.grossProfit >= 0 ? "text-emerald-600" : "text-red-600"}`}>{formatCurrency(item.grossProfit)}</TableCell>
                      <TableCell className="text-right text-destructive">{formatCurrency(item.expenses)}</TableCell>
                      <TableCell className={`text-right font-medium ${item.netProfit >= 0 ? "text-green-600" : "text-red-600"}`}>{formatCurrency(item.netProfit)}</TableCell>
                      <TableCell className="text-right">{item.revenue > 0 ? `${((item.netProfit / item.revenue) * 100).toFixed(1)}%` : "0%"}</TableCell>
                    </TableRow>
                  ))}
                  <TableRow className="font-bold border-t-2 bg-muted">
                    <TableCell>Total</TableCell>
                    <TableCell className="text-right">{formatCurrency(monthlyTotals.revenue)}</TableCell>
                    <TableCell className="text-right text-blue-600">{formatCurrency(monthlyTotals.cogs)}</TableCell>
                    <TableCell className="text-right">{formatCurrency(monthlyTotals.grossProfit)}</TableCell>
                    <TableCell className="text-right text-destructive">{formatCurrency(monthlyTotals.expenses)}</TableCell>
                    <TableCell className="text-right">{formatCurrency(monthlyTotals.netProfit)}</TableCell>
                    <TableCell className="text-right">-</TableCell>
                  </TableRow>
                </TableBody>
              </Table>
            </CardContent>
          </Card>
        </TabsContent>
      </Tabs>
    </div>
  );
};

export default Reports;
